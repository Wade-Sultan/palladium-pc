# Copy to .env.local (gitignored via the repo-root `.env.*` rule) and fill in.
# Consumed by the secretGenerator in kustomization.yaml, which turns it into
# the palladium-secrets Secret. Never commit the filled-in copy.
#
# Everything here is a credential or embeds one. Non-secret settings belong in
# the ConfigMaps under patches/config-local.yaml instead.

# --- Postgres (the in-cluster StatefulSet, not Cloud SQL) -------------------
# Must match the POSTGRES_PASSWORD the StatefulSet initialises with; it reads
# this same key. Any value works locally. It never leaves the cluster.
POSTGRES_PASSWORD=change-me-locally

# builder (FastAPI). Scheme stays postgresql://: config.py rewrites it to
# postgresql+psycopg:// itself. Host is the headless Service name.
POSTGRES_DB_URL=postgresql://palladium_app:change-me-locally@postgres:5432/palladium_local

# commerce (pgx) and admin (Prisma) share this one. sslmode=disable because
# traffic never leaves the cluster network.
DATABASE_URL=postgresql://palladium_app:change-me-locally@postgres:5432/palladium_local?sslmode=disable

# --- App secrets ------------------------------------------------------------
SECRET_KEY=change-me-locally
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-me-locally

# --- Automated testing ------------------------------------------------------
# Turns on the stub-LM path for any request presenting this value in the
# X-Palladium-Load-Test header (app/core/loadtest.py). It is what lets a test
# drive a REAL turn, published to Pub/Sub, run by the worker, streamed through
# Valkey, committed to Postgres, while making zero LLM calls, so the assertions
# are deterministic and nothing has to be loaded in LM Studio.
#
# The stubs attach at the only two outbound chokepoints and the flag travels in
# the Pub/Sub message body, so the worker re-enters stub mode on the far side.
# It is ANDed with this variable being set on BOTH sides, which is why a
# deployment that leaves it blank cannot be put into stub mode at all.
#
# Any value works locally. In production this is a real credential and lives in
# Secret Manager; here it never leaves the machine.
LOAD_TEST_SECRET=local-stub-lm-secret

# --- Third-party keys (copy from the repo-root .env) ------------------------
# Chat completions go to LM Studio locally (LLM_BASE_URL in
# patches/config-local.yaml), so no chat turn spends this key. Parts discovery
# still does. It needs a multimodal model and stays on OpenRouter, see
# DISCOVERY_LLM_BASE_URL in the same file.
#
# So: a placeholder is enough to boot and to develop against chat (the setting
# is required, and the API will not start without some value). Put the real key
# in if you intend to run discovery, or to point the overlay back at OpenRouter.
OPENROUTER_API_KEY=unused-locally
SERPAPI_KEY=
TAVILY_API_KEY=
HF_TOKEN=
DISCOVERY_API_KEY=
RESEND_API_KEY=
AMAZON_ASSOCIATE_TAG=
EBAY_CAMPAIGN_ID=
